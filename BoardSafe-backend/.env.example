DB_PASSWORD=CHANGE_DB_PASSWORD
BOARDSAFE_ENVIRONMENT=development
BOARDSAFE_DATABASE_URL=postgresql+psycopg://boardsafe:CHANGE_DB_PASSWORD@postgres:5432/boardsafe
BOARDSAFE_JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOARDSAFE_ACCESS_TOKEN_MINUTES=60
BOARDSAFE_JWT_CLOCK_SKEW_SECONDS=5
BOARDSAFE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOARDSAFE_OSRM_BASE_URL=http://osrm:5000
BOARDSAFE_ROUTING_TIMEOUT_SECONDS=8
BOARDSAFE_PUBLIC_OSRM_ALLOWED=false
BOARDSAFE_BAY_STALENESS_SECONDS=180
BOARDSAFE_VEHICLE_STALENESS_SECONDS=180
BOARDSAFE_ROUTE_VALIDITY_MINUTES=60
BOARDSAFE_EVENT_POLL_SECONDS=2
BOARDSAFE_INGEST_TOKEN=REPLACE_ME_WITH_SEPARATE_LONG_MACHINE_SECRET
BOARDSAFE_OPEN_METEO_ENABLED=false

# Bootstrap after migrations; configure BOTH. Never store a real password in Git.
BOARDSAFE_BOOTSTRAP_ADMIN_EMAIL=
BOARDSAFE_BOOTSTRAP_ADMIN_PASSWORD=
