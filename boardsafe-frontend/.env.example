# Local browser API and institutional WebSocket.
NEXT_PUBLIC_BOARDSAFE_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_BOARDSAFE_WS_URL=ws://127.0.0.1:8000/api/v1/ws/events
# Optional public MapTiler key; restrict it to the deployment domain.
NEXT_PUBLIC_MAPTILER_KEY=
# Private server configuration for the kiosk gateway; never NEXT_PUBLIC.
BOARDSAFE_INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
BOARDSAFE_KIOSK_NODE_ID=
BOARDSAFE_KIOSK_NODE_KEY=
