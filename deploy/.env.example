# Generate a private copy with scripts/deploy_config.py --init --origin ...
DB_PASSWORD=REPLACE_WITH_OWNER_DATABASE_SECRET
DB_APP_PASSWORD=REPLACE_WITH_INDEPENDENT_APPLICATION_DATABASE_SECRET
BOARDSAFE_JWT_SECRET=REPLACE_WITH_INDEPENDENT_JWT_SECRET
BOARDSAFE_INGEST_TOKEN=REPLACE_WITH_INDEPENDENT_INGEST_SECRET
BOARDSAFE_CORS_ORIGINS=https://boardsafe.example.org
BOARDSAFE_OSRM_BASE_URL=http://osrm:5000
BOARDSAFE_PUBLIC_OSRM_ALLOWED=false
BOARDSAFE_OPEN_METEO_ENABLED=false
NEXT_PUBLIC_MAPTILER_KEY=
BOARDSAFE_BIND_ADDRESS=127.0.0.1
BOARDSAFE_HTTP_PORT=8080
# Use the same image to prepare the graph and serve it; pin a validated digest for release.
BOARDSAFE_OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest

# Private runtime credentials: provision a totem from the admin UI first.
BOARDSAFE_KIOSK_NODE_ID=
BOARDSAFE_KIOSK_NODE_KEY=

# Bootstrap after migrations; configure BOTH. Never store a real password in Git.
BOARDSAFE_BOOTSTRAP_ADMIN_EMAIL=
BOARDSAFE_BOOTSTRAP_ADMIN_PASSWORD=
